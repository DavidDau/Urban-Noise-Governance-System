# Backend environment variables - copy to .env

# Environment
ENVIRONMENT=production

# Database - PostgreSQL (recommended for production)
DATABASE_URL=postgresql://noisegov_user:noisegov_password@localhost:5432/noisegov

# For development with SQLite (uncomment to use):
# DATABASE_URL=sqlite:///./noisegov.db

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# CORS Origins (comma-separated)
# Update with your actual frontend domain
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Reports directory
REPORTS_DIR=./reports

# TensorFlow (suppress verbose output)
TF_CPP_MIN_LOG_LEVEL=2
